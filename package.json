  "name": "sillytavern-remastered",
  "type": "module",
  "workspaces": [
    "src",
    "src/client/extensions/*"
  ],
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/LordAlbior/SillyTavern-Remastered.git"
  },
  "version": "1.18.0",
  "scripts": {
    "init": "bun",
    "start": "bun --cwd src build-frontend.ts && bun --cwd src server.ts",
    "start:global": "bun --cwd src build-frontend.ts && bun --cwd src server.ts --global",
    "start:no-csrf": "bun --cwd src build-frontend.ts && bun --cwd src server.ts --disableCsrf",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc -p src/tsconfig.json --noEmit",
    "plugins:update": "bun --cwd src plugins update",
    "plugins:install": "bun --cwd src plugins install",
    "quality": "bunx fallow",
    "quality:audit": "bunx fallow audit",
    "quality:dead-code": "bunx fallow dead-code",
    "quality:dupes": "bunx fallow dupes",
    "quality:health": "bunx fallow health --score",
    "quality:security": "bunx fallow security",
    "quality:recommend": "bunx fallow recommend",
    "quality:type-aware": "bunx fallow dead-code --type-aware",
    "quality:a11y": "bunx pa11y --runner axe --level error --threshold 0 http://localhost:8000",
    "security:sast": "semgrep scan --config auto",
    "security:trivy": "trivy filesystem . --severity HIGH,CRITICAL --exit-code 1",
    "security:spectral": "spectral lint ."
  },
  "bin": {
    "sillytavern": "./src/server/server-global.ts"
  },
  "rules": {
    "no-path-concat": "off",
    "no-var": "off"
  },
  "main": "src/server.ts",
  "devDependencies": {
