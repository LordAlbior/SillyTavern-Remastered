{
  "name": "@sillytavern/app",
  "version": "1.18.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:frontend": "bun build-frontend.ts",
    "start": "bun build-frontend.ts && bun server.ts",
    "start:global": "bun build-frontend.ts && bun server.ts --global",
    "start:no-csrf": "bun build-frontend.ts && bun server.ts --disableCsrf",
    "plugins:update": "bun plugins update",
    "plugins:install": "bun plugins install"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}