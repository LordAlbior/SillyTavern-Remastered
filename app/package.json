{
  "name": "@sillytavern/app",
  "version": "1.18.0",
  "private": true,
  "type": "module",
  "main": "server.js",
  "bin": {
    "sillytavern": "./src/server-global.js"
  },
  "scripts": {
    "start": "bun server.js",
    "start:node": "node server.js",
    "debug": "bun --inspect server.js",
    "start:global": "bun server.js --global",
    "start:electron": "cd ./src/electron && bun run start",
    "start:no-csrf": "bun server.js --disableCsrf",
    "plugins:update": "bun plugins update",
    "plugins:install": "bun plugins install"
  }
}
